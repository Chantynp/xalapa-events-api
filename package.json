{
  "name": "xalapa-events-api",
  "version": "1.0.0",
  "description": "Datos de Xalapa para la app: eventos de Eventbrite y rutas del transporte publico",
  "private": true,
  "scripts": {
    "fetch": "node scripts/fetch-events.js",
    "fetch:dev": "node -e \"require('dotenv').config(); require('./scripts/fetch-events.js')\"",
    "routes": "node scripts/build-routes.js",
    "routes:sync": "node scripts/build-routes.js --sync-app ../XalapaConnectMVP/src/data/routesFallback.js",
    "routes:import": "node scripts/import-kml.js"
  },
  "devDependencies": {
    "dotenv": "^17.4.2"
  }
}
